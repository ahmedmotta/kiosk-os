# Kiosk OS boot screen: white background, logo + text, three pulsing orange dots.
# Images are pre-sized (1x for ~1280 px wide screens, 2x for Retina) because
# Plymouth's own scaling is nearest-neighbour and makes text look broken.

Window.SetBackgroundTopColor(1.0, 1.0, 1.0);
Window.SetBackgroundBottomColor(1.0, 1.0, 1.0);

sw = Window.GetWidth();
sh = Window.GetHeight();

if (sw >= 2000) {
  splash = Image("splash-2x.png");
  dot = Image("dot-2x.png");
} else {
  splash = Image("splash.png");
  dot = Image("dot.png");
}

# Only if the screen is unexpectedly small, shrink (rare).
if (splash.GetHeight() > sh * 0.8) {
  f = (sh * 0.7) / splash.GetHeight();
  splash = splash.Scale(Math.Int(splash.GetWidth() * f), Math.Int(splash.GetHeight() * f));
}

logo = Sprite(splash);
lx = Math.Int(sw / 2 - splash.GetWidth() / 2);
ly = Math.Int(sh / 2 - splash.GetHeight() / 2 - sh * 0.04);
logo.SetPosition(lx, ly, 10);

size = dot.GetWidth();
gap = size * 2;
startx = Math.Int(sw / 2 - (gap * 2 + size) / 2);
doty = Math.Int(Math.Min(sh * 0.88, ly + splash.GetHeight() + size * 3));

for (i = 0; i < 3; i++) {
  dots[i] = Sprite(dot);
  dots[i].SetPosition(startx + i * gap, doty, 10);
}

tick = 0;
fun refresh_callback () {
  tick++;
  for (i = 0; i < 3; i++) {
    dots[i].SetOpacity(0.2 + 0.8 * Math.Abs(Math.Sin(tick / 14 - i * 0.8)));
  }
}
Plymouth.SetRefreshFunction(refresh_callback);

fun message_callback (text) { }
Plymouth.SetMessageFunction(message_callback);
